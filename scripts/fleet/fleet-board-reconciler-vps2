#!/usr/bin/env python3
"""VPS2 entry point for the fail-closed broker-native fleet dispatcher."""
from __future__ import annotations

import os
import runpy
import sys
from pathlib import Path


HOST_IDENTITY = "blitz-vps-2"
if os.environ.get("FLEET_HOST_IDENTITY") != HOST_IDENTITY:
    environment = dict(os.environ)
    environment["FLEET_HOST_IDENTITY"] = HOST_IDENTITY
    environment["FLEET_DISPATCH_EXPECTED_HOST"] = HOST_IDENTITY
    environment.setdefault("BOARDD_SOCK", "/run/boardd-blitz.sock")
    os.execve(sys.executable, [sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]], environment)

os.environ["FLEET_DISPATCH_EXPECTED_HOST"] = HOST_IDENTITY
os.environ.setdefault("BOARDD_SOCK", "/run/boardd-blitz.sock")
runpy.run_path(
    str(Path(__file__).with_name("fleet-board-reconciler")),
    run_name="__main__",
)
