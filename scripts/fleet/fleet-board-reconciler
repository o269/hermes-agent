#!/usr/bin/env python3
"""Fail-closed, broker-native fleet dispatcher for the blitz host.

All task selection and capacity decisions are finalized by boardd's atomic
``claim_with_custody`` mutation. This process only discovers candidate lanes,
spawns the winner, and records the spawned PID under the exact claim lock.
"""
from __future__ import annotations

import os
import signal
import socket
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


EXPECTED_HOST_IDENTITY = os.environ.get("FLEET_DISPATCH_EXPECTED_HOST", "blitz")


def _ensure_process_host_identity() -> None:
    """Re-exec once so /proc/<pid>/environ contains the custody token."""
    if os.environ.get("FLEET_HOST_IDENTITY") == EXPECTED_HOST_IDENTITY:
        return
    env = dict(os.environ)
    env["FLEET_HOST_IDENTITY"] = EXPECTED_HOST_IDENTITY
    env["FLEET_DISPATCH_EXPECTED_HOST"] = EXPECTED_HOST_IDENTITY
    os.execve(sys.executable, [sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]], env)


_ensure_process_host_identity()
os.environ.setdefault("KB_CLIENT_RETRY_DEADLINE_S", "3")
os.environ.setdefault("KB_CLIENT_CONNECT_TIMEOUT_S", "1")

REPO_ROOT = Path(__file__).resolve().parents[2]
if (REPO_ROOT / "hermes_cli" / "kb_client.py").exists():
    sys.path.insert(0, str(REPO_ROOT))

from hermes_cli.kb_client import BoarddError, BoarddUnavailable, Client  # noqa: E402


HOST_IDENTITY = EXPECTED_HOST_IDENTITY
IS_VPS2 = HOST_IDENTITY == "blitz-vps-2"
HOME = os.environ.get("HOME", "/root" if IS_VPS2 else "/home/odai")
HERMES_HOME = os.environ.get("HERMES_HOME", os.path.join(HOME, ".hermes"))
BOARDD_SOCK = os.environ.get(
    "BOARDD_SOCK",
    "/run/boardd-blitz.sock"
    if IS_VPS2
    else "/home/odai/.hermes/kanban/boardd-run/boardd.sock",
)
HERMES_BIN = os.environ.get(
    "HERMES_BIN", "/root/.local/bin/hermes" if IS_VPS2 else "/home/odai/.local/bin/hermes"
)
BOARD = os.environ.get("FLEET_BOARD", "fleet")
CLAIM_TTL = int(os.environ.get("FLEET_CLAIM_TTL_SECONDS", "7200"))
WORKSPACE_ROOT = os.environ.get(
    "FLEET_WORKSPACE_ROOT",
    "/mnt/HC_Volume_106418160/fleet-workspaces"
    if IS_VPS2
    else "/home/odai/.hermes/kanban/boards/fleet/workspaces",
)
LOG = os.environ.get(
    "FLEET_DISPATCH_LOG",
    os.path.join(HERMES_HOME, "kanban", "vps2-dispatch.log" if IS_VPS2 else "reconciler.log"),
)
DEFAULT_VPS2_LANES = ",".join(
    [*(f"vps2-eng{i}" for i in range(1, 5)), *(f"vps2-gemini{i}" for i in range(1, 5))]
)
CONTROL_ASSIGNEES = {
    item.strip().lower()
    for item in os.environ.get(
        "FLEET_CONTROL_ASSIGNEES", "security,fable,orchestrator,warden,council"
    ).split(",")
    if item.strip()
}


def log(message: str) -> None:
    line = f"{datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {message}\n"
    sys.stderr.write(line)
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a", encoding="utf-8") as log_file:
            log_file.write(line)
    except OSError:
        pass


def _client() -> Client:
    return Client(
        sock_path=BOARDD_SOCK,
        worker_id=f"{HOST_IDENTITY}:{socket.gethostname()}:{os.getpid()}",
    )


def _pid_alive(pid: object) -> bool:
    try:
        value = int(pid)
    except (TypeError, ValueError):
        return False
    if value <= 0:
        return False
    try:
        os.kill(value, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def _foreign_live_workers(client: Client) -> list[dict]:
    rows = client.query(
        "SELECT id, host_identity, worker_pid FROM tasks "
        "WHERE status='running' AND host_identity IS NOT ? AND worker_pid IS NOT NULL",
        [HOST_IDENTITY],
    )
    return [row for row in rows if _pid_alive(row.get("worker_pid"))]


def _candidate_lanes(client: Client) -> list[str]:
    if IS_VPS2:
        configured = [
            item.strip().lower()
            for item in os.environ.get("VPS2_DISPATCH_ALLOWLIST", DEFAULT_VPS2_LANES).split(",")
            if item.strip()
        ]
        if not configured:
            return []
        placeholders = ",".join("?" for _ in configured)
        rows = client.query(
            "SELECT assignee, MAX(priority) AS lane_priority, MIN(created_at) AS oldest "
            "FROM tasks WHERE status='ready' AND claim_lock IS NULL "
            f"AND assignee IN ({placeholders}) GROUP BY assignee "
            "ORDER BY lane_priority DESC, oldest ASC",
            configured,
        )
    else:
        rows = client.query(
            "SELECT assignee, MAX(priority) AS lane_priority, MIN(created_at) AS oldest "
            "FROM tasks WHERE status='ready' AND claim_lock IS NULL "
            "AND assignee IS NOT NULL AND lower(assignee) NOT LIKE 'vps2-%' "
            "GROUP BY assignee ORDER BY lane_priority DESC, oldest ASC"
        )
    lanes: list[str] = []
    for row in rows:
        lane = str(row.get("assignee") or "").strip().lower()
        if lane and lane not in CONTROL_ASSIGNEES:
            lanes.append(lane)
    return lanes


def _terminate_unrecorded_worker(proc: subprocess.Popen) -> None:
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except OSError:
        try:
            proc.terminate()
        except OSError:
            pass


def _spawn_worker(
    client: Client,
    *,
    task_id: str,
    assignee: str,
    run_id: int,
    claim_lock: str,
) -> int | None:
    task = client.get_task(task_id) or {}
    workspace = task.get("workspace_path") or os.path.join(WORKSPACE_ROOT, task_id)
    try:
        os.makedirs(workspace, exist_ok=True)
        client.set_workspace_path(task_id, workspace)
    except (OSError, BoarddError) as exc:
        log(f"SPAWN-PREP-FAIL {task_id} {exc}")
        return None

    env = dict(os.environ)
    env.update(
        {
            "FLEET_HOST_IDENTITY": HOST_IDENTITY,
            "HERMES_KANBAN_BROKER": "1",
            "BOARDD_SOCK": BOARDD_SOCK,
            "HERMES_KANBAN_BOARD": BOARD,
            "HERMES_KANBAN_TASK": task_id,
            "HERMES_KANBAN_RUN_ID": str(run_id),
            "HERMES_KANBAN_CLAIM_LOCK": claim_lock,
            "HERMES_KANBAN_WORKSPACE": workspace,
            "HERMES_KANBAN_WORKSPACES_ROOT": WORKSPACE_ROOT,
            "HOME": HOME,
        }
    )
    env.pop("HERMES_TUI", None)
    command = [
        HERMES_BIN,
        "-p",
        assignee,
        "--cli",
        "--accept-hooks",
        "chat",
        "-q",
        f"work kanban task {task_id}",
    ]
    log_path = os.path.join(workspace, "agent.log")
    try:
        with open(log_path, "ab") as log_file:
            proc = subprocess.Popen(
                command,
                cwd=workspace,
                stdin=subprocess.DEVNULL,
                stdout=log_file,
                stderr=subprocess.STDOUT,
                env=env,
                start_new_session=True,
            )
    except OSError as exc:
        log(f"SPAWN-FAIL {task_id} {exc}")
        return None

    try:
        recorded = client.record_worker_pid(task_id, run_id, proc.pid, claim_lock)
    except (BoarddError, BoarddUnavailable) as exc:
        log(f"RECORD-PID-FAIL {task_id} pid={proc.pid} {exc}")
        _terminate_unrecorded_worker(proc)
        return None
    if not recorded.get("ok"):
        log(
            f"RECORD-PID-FAIL {task_id} pid={proc.pid} "
            f"reason={recorded.get('reason', 'unknown')}"
        )
        _terminate_unrecorded_worker(proc)
        return None
    log(f"SPAWN {task_id} -> {assignee} pid={proc.pid} run_id={run_id}")
    return proc.pid


def _dispatch(client: Client) -> int:
    spawned = 0
    for assignee in _candidate_lanes(client):
        result = client.claim_with_custody(
            assignee=assignee,
            task_id=None,
            ttl_seconds=CLAIM_TTL,
        )
        if not result.get("won"):
            reason = result.get("reason", "claim_failed")
            log(f"CLAIM-SKIP assignee={assignee} reason={reason}")
            if reason in {"host_capacity", "global_capacity"}:
                break
            continue
        task_id = result["task_id"]
        run_id = int(result["run_id"])
        claim_lock = result["claim_lock"]
        log(f"CLAIM-WON {task_id} -> {assignee} run_id={run_id}")
        if _spawn_worker(
            client,
            task_id=task_id,
            assignee=assignee,
            run_id=run_id,
            claim_lock=claim_lock,
        ) is not None:
            spawned += 1
    return spawned


def main() -> int:
    if IS_VPS2 and os.environ.get("FLEET_VPS2_DISABLED") == "1":
        log("VPS2-DISPATCH-DISABLED")
        return 0
    if not os.path.exists(BOARDD_SOCK):
        if IS_VPS2:
            log("FATAL: vps2 dispatcher cannot reach boardd")
        else:
            log("FATAL: blitz dispatcher cannot reach boardd")
        return 1

    client = _client()
    try:
        client.ping()
        foreign = _foreign_live_workers(client)
        if foreign:
            evidence = ",".join(
                f"{row['id']}@{row.get('host_identity')}:{row.get('worker_pid')}"
                for row in foreign
            )
            log(f"FATAL: split-brain live foreign worker(s): {evidence}")
            return 1
        spawned = _dispatch(client)
    except (BoarddError, BoarddUnavailable, OSError) as exc:
        if IS_VPS2:
            log("FATAL: vps2 dispatcher cannot reach boardd")
        else:
            log("FATAL: blitz dispatcher cannot reach boardd")
        log(f"BROKER-ERROR {exc}")
        return 1
    finally:
        client.close()

    log(f"PASS host_identity={HOST_IDENTITY} spawned={spawned}")
    print(f"Spawned: {spawned}")
    print("Crashed: 0")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
