[Unit]
Description=Hermes boardd finalized-backup freshness and integrity monitor
Documentation=https://github.com/o269/hermes-agent/blob/main/docs/operations/boardd-backup-monitor.md
After=local-fs.target

[Service]
Type=oneshot
User=boardd
Group=boardd
WorkingDirectory=/
Environment=BOARDD_BACKUP_DIR=/var/lib/boardd/fleet/boardd-backups
Environment=BOARDD_BACKUP_INTERVAL_S=900
Environment=BOARDD_BACKUP_MONITOR_MAX_AGE_SECONDS=2700
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/default/boardd-backup-monitor
ExecStartPre=/usr/bin/test -x /opt/hermes-boardd-backup-monitor/current/boardd-backup-monitor.py
ExecStart=/usr/bin/python3 /opt/hermes-boardd-backup-monitor/current/boardd-backup-monitor.py
TimeoutStartSec=5min
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=boardd-backup-monitor

# The monitor is read-only and cannot reach the live DB or its WAL sidecars.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=-/var/lib/boardd/fleet/boardd-backups /opt/hermes-boardd-backup-monitor
InaccessiblePaths=-/var/lib/boardd/fleet/kanban.db -/var/lib/boardd/fleet/kanban.db-wal -/var/lib/boardd/fleet/kanban.db-shm
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RemoveIPC=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
