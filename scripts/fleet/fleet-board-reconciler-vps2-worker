#!/usr/bin/env bash
# fleet-board-reconciler-vps2-worker — blitz SSH-spawn for vps2-* lanes (R4).
set -euo pipefail

export HERMES_KANBAN_BROKER="${HERMES_KANBAN_BROKER:-1}"
export BOARDD_SOCK="${BOARDD_SOCK:-/home/odai/.hermes/kanban/boardd-run/boardd.sock}"

HERMES_HOME="${HERMES_HOME:-/home/odai/.hermes/hermes-agent}"
VENV_SITE="${HERMES_VENV_SITE_PACKAGES:-$HERMES_HOME/venv/lib/python3.12/site-packages}"
if [ -d "$VENV_SITE" ]; then
  export PYTHONPATH="${VENV_SITE}${PYTHONPATH:+:$PYTHONPATH}"
fi

exec python3 -m hermes_cli.fleet_vps2_dispatch "$@"
