# Installed copy: ~/.config/merge-truth-reconciler.env (mode 0600)
# Fail closed by default. Fable enables only after independent exact-head review
# and a green broker helper capability handshake against live boardd.
MERGE_TRUTH_RECONCILER_ENABLED=0

# Required broker-only helper (post-PR36/PR38/PR41). Installed beside the
# reconciler payload; implements the runbook capability contract via boardd.
MERGE_TRUTH_RECONCILER_BOARD_HELPER=%h/.local/lib/merge-truth-reconciler/merge_truth_board_helper.py

# Broker runtime (required by the helper; never open the fleet SQLite file).
HERMES_KANBAN_BROKER=1
BOARDD_SOCK=/run/boardd/boardd.sock

# Host admission safety. Values may only be tightened: load ceiling <=12.0,
# SDB reserve >=15 GiB (15728640 KiB). Missing/unreadable samples skip the tick.
MERGE_TRUTH_RECONCILER_LOAD1_MAX=12.0
MERGE_TRUTH_RECONCILER_SDB_MOUNT=/mnt/HC_Volume_106418160
MERGE_TRUTH_RECONCILER_SDB_MIN_FREE_KIB=15728640

MERGE_TRUTH_RECONCILER_SOURCE_ARTIFACTS=%h/godmode-bus/artifacts
MERGE_TRUTH_RECONCILER_STATE_DIR=%h/.local/state/merge-truth-reconciler
MERGE_TRUTH_RECONCILER_REPORT_DIR=%h/godmode-bus/artifacts/merge-truth-reconciler
MERGE_TRUTH_RECONCILER_STATUS_TICKER=%h/godmode-bus/STATUS-TICKER.md
MERGE_TRUTH_RECONCILER_ALERT_DIR=%h/godmode-bus/to-claude

# TTL applies only to bounded artifact-derived repositories. Live board inventory
# is queried and merged additively on every admitted tick. Cadence/growth maxima:
# TTL <=86400s, bootstrap <=30d, overlap <=600s, request timeout <=20s,
# helper timeout <=30s, and pages/repository <=20. All may be tightened only.
# Artifact limits may likewise be tightened but not increased.
MERGE_TRUTH_RECONCILER_INVENTORY_TTL_SECONDS=86400
MERGE_TRUTH_RECONCILER_ARTIFACT_MAX_CANDIDATES=500
MERGE_TRUTH_RECONCILER_ARTIFACT_MAX_FILE_BYTES=1000000
MERGE_TRUTH_RECONCILER_ARTIFACT_MAX_TOTAL_BYTES=20000000
MERGE_TRUTH_RECONCILER_ARTIFACT_MAX_ELAPSED_MS=5000

# Timestamped report limits preserve latest.json. Values may be tightened only.
MERGE_TRUTH_RECONCILER_REPORT_RETENTION_COUNT=100
MERGE_TRUTH_RECONCILER_REPORT_RETENTION_DAYS=30

MERGE_TRUTH_RECONCILER_BOOTSTRAP_DAYS=30
MERGE_TRUTH_RECONCILER_OVERLAP_SECONDS=600
MERGE_TRUTH_RECONCILER_REQUEST_TIMEOUT_SECONDS=20
MERGE_TRUTH_RECONCILER_HELPER_TIMEOUT_SECONDS=30
MERGE_TRUTH_RECONCILER_MAX_PAGES_PER_REPO=20
MERGE_TRUTH_RECONCILER_GITHUB_API_BASE=https://api.github.com
